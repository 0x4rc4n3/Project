# ScatterID Environment Variables
# Copy this to .env and fill in values, or export them before running services

# API Key used for internal authenticated communication between verification-api and crypto-service
export CRYPTO_SERVICE_API_KEY="scatterid-internal-crypto-api-key-xyz987"

# Path to the Root CA certificate to trust self-signed TLS certs in Node.js
export NODE_EXTRA_CA_CERTS="/home/arcane/ScatterID/components/crypto/certs/ca.crt"

# HashiCorp Vault endpoints and credentials for KMS key retrieval
export VAULT_ADDR="http://localhost:8200"
export VAULT_TOKEN="scatterid-vault-root-token"
